# ─── Server ───
NODE_ENV=development
PORT=3000
# Public URL of the app (used for links/health checks in docs). Optional locally.
APP_URL=http://localhost:5173
# Set to true when running behind a reverse proxy / PaaS load balancer (Render, Fly, Railway…)
TRUST_PROXY=false

# ─── PostgreSQL (existing database) ───
# Pooled connection used by the app at runtime (Neon: the "-pooler" host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/MyGym?sslmode=require&channel_binding=require&connect_timeout=30"
# Direct (non-pooled) connection used by `prisma migrate` (Neon: same host without "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/MyGym?sslmode=require&channel_binding=require&connect_timeout=30"
# Separate, disposable database for automated tests. NEVER point this at production.
TEST_DATABASE_URL=postgresql://postgres:test@localhost:55432/myfit_test

# ─── Sessions & first-run setup ───
# Random string ≥ 32 chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_DAYS=60
# Optional: if set, the first-run setup form must supply this token (recommended in production).
SETUP_TOKEN=
DEFAULT_TIMEZONE=Asia/Kolkata

# ─── Media bucket (existing S3-compatible bucket, e.g. Neon storage) ───
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=my-gym
S3_FORCE_PATH_STYLE=true
# Max upload size in bytes (default 8 MB) and signed URL lifetime in seconds.
MEDIA_MAX_BYTES=8388608
SIGNED_URL_TTL_SECONDS=900

# ─── Web Push (VAPID) — generate with: npm run vapid:generate ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Reminder scheduler (runs inside the web service) ───
SCHEDULER_ENABLED=true
